# csnl-ops environment variables
# Copy to .env.local (never commit) and fill in real values. Many are shared
# with lab-reservation — see DEPLOY.md for which env vars must match vs.
# diverge across the two repos.

# ── Supabase (same instance as lab-reservation; csnl_ops schema isolation) ───

# Cloud project ref: qjhzjqkrbvsnwlbpilio (CSNL-vnilab's Project)
# REUSE lab-reservation's URL and service-role key for now (see DEPLOY.md
# Risk Ledger). Mint csnl-ops-specific service_role only when csnl-ops
# acquires a webhook needing independent rotation.
NEXT_PUBLIC_SUPABASE_URL=https://qjhzjqkrbvsnwlbpilio.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (for psql verification scripts).
# Reuse lab-reservation/.env.local DATABASE_URL or build from the pooler.
DATABASE_URL=

# ── Google Service Account (REUSE lab-reservation's SA verbatim) ─────────────

# Same SA as lab-reservation: slab-836@claudeslab.iam.gserviceaccount.com
# Both Slab + CSNL calendars are shared with this SA.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Google Calendar IDs ──────────────────────────────────────────────────────

# Slab calendar (행동실험 예약). Same calendar lab-reservation uses for
# its booking events, so this is GOOGLE_CALENDAR_ID over there.
CSNL_OPS_SLAB_CALENDAR_ID=dvjmpc33e56l0euaq4c0dekvu4@group.calendar.google.com

# CSNL calendar (Milestone Meeting + GRM). Personal-calendar style ID.
# Confirmed shared with SA 2026-05-04.
CSNL_OPS_CSNL_CALENDAR_ID=vnilab@gmail.com

# ── Cron auth (csnl-ops OWN secret — do NOT reuse lab-reservation's) ─────────

# Generate with: openssl rand -hex 32
# This is the secret GH Actions cron jobs will pass via x-cron-secret header
# to /api/cron/* endpoints. Separate from lab-reservation's CRON_SECRET so
# a leak in one doesn't compromise the other.
CRON_SECRET=

# ── Email (Gmail SMTP — REUSED with lab-reservation) ─────────────────────────

# Sender: vnilab@gmail.com
# GMAIL_APP_PASSWORD is a Google account app-password (16 chars, no spaces).
# Rotation cascades to lab-reservation; document any rotation in both repos.
GMAIL_USER=vnilab@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# ── NAS (Mac-only; not present on Vercel runtime or GH Actions) ──────────────

# smb://147.47.70.15/CSNL_new mount root.
# Local scripts (scripts/walk-*, scripts/resolve-mm-slides.mjs) require this.
# Vercel route handlers must not depend on it.
NAS_ROOT=/Volumes/CSNL_new-2

# ── Vercel deployment URL (set by Vercel runtime; for local dry-runs only) ───

# Used by GH Actions workflows when they curl POST the cron endpoints.
# Format: https://<project>.vercel.app or custom domain.
CSNL_OPS_VERCEL_URL=
