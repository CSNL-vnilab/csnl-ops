# csnl-researcher-archiver — local config (per PC)

# === REQUIRED ===
MY_INIT=               # Your initials, exact case (e.g., JOP, BHL). Must match config/researchers.yaml.

# Supabase DB connection (session pooler, persistent connections)
# Get host + password from operator (do NOT use the dashboard service_role JWT here).
SUPABASE_DB_HOST=      # e.g., aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=      # format: postgres.<project_ref> — operator provides
SUPABASE_DB_PASSWORD=  # operator provides via secure channel

# === OPTIONAL ===
NAS_ROOT=              # /Volumes/CSNL_new (only if NAS mounted; leave empty for local-only)

# Optional: plugin root (auto-detected by install.sh)
# PLUGIN_ROOT=

# Optional: verbose logging
# CSNL_ARCHIVE_DEBUG=1
