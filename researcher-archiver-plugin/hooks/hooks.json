{
  "description": "csnl-archive hooks. PreToolUse tone lint on Write/Edit; SessionEnd auto-handoff. Both non-blocking (lint exits 1 to log violations to stderr without killing the op; handoff writes a minimal snapshot file).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-fire-lint.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/auto-handoff.sh\" \"${MY_INIT:-}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
