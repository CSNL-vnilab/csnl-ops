-- =============================================================================
-- PART A: Run on lab-reservation (SOURCE project) SQL editor
-- =============================================================================

-- Step A1: Create the read-only role for csnl-ops to use.
-- Choose a strong password and store it in the csnl-ops Vault (see Part B).

CREATE ROLE csnl_ops_fdw_reader
  WITH LOGIN
  PASSWORD '<REPLACE_WITH_STRONG_PASSWORD>';    -- DO NOT commit this value

GRANT CONNECT ON DATABASE postgres TO csnl_ops_fdw_reader;
GRANT USAGE ON SCHEMA public TO csnl_ops_fdw_reader;

-- Step A2: Grant SELECT on all tables the FDW migration will import.
-- If any of these tables do not yet exist, run this after they are created.
GRANT SELECT ON
  public.bookings,
  public.experiments,
  public.booking_observations,
  public.experiment_run_progress,
  public.profiles,
  public.experiment_locations,
  public.participant_lab_identity
TO csnl_ops_fdw_reader;

-- Step A3: (Optional) Verify the role was created:
-- SELECT rolname, rolcanlogin FROM pg_roles WHERE rolname = 'csnl_ops_fdw_reader';


-- =============================================================================
-- PART B: Run on csnl-ops (DESTINATION project) Vault setup
-- =============================================================================
-- Use the Supabase Dashboard → Database → Vault → "Add secret" UI, OR run
-- the following SQL in the csnl-ops SQL editor as the postgres superuser.
--
-- Secret names must match EXACTLY what the migration references.

-- Store the password chosen in Step A1:
SELECT vault.create_secret(
  '<REPLACE_WITH_STRONG_PASSWORD>',    -- DO NOT commit this value
  'lab_reservation_fdw_password',
  'Password for csnl_ops_fdw_reader on lab-reservation Supabase'
);

-- Store the lab-reservation Transaction Pooler hostname:
-- Find it in lab-reservation Supabase Dashboard →
--   Settings → Database → Connection string → Transaction pooler host
-- Example value: "aws-0-ap-northeast-2.pooler.supabase.com"
-- (port is always 5432 for Session mode; do NOT include it here)
SELECT vault.create_secret(
  '<LAB_RESERVATION_POOLER_HOST>',    -- e.g. aws-0-ap-northeast-2.pooler.supabase.com
  'lab_reservation_fdw_host',
  'Transaction pooler host for lab-reservation Supabase (FDW target)'
);

-- Step B3: Verify secrets were stored (values are NOT returned, only names):
-- SELECT name, description FROM vault.secrets;


